"""
审计规则模板控制器
"""
from fastapi import APIRouter, Depends, Path, Query
from fastapi.responses import JSONResponse

from app.common.response import SuccessResponse, ErrorResponse
from app.common.request import PaginationService
from app.core.router_class import OperationLogRoute
from app.core.dependencies import AuthPermission
from app.core.base_params import PaginationQueryParam
from app.api.v1.module_system.auth.schema import AuthSchema
from app.plugin.module_application.audit.rule_template import service
from app.plugin.module_application.audit.rule_template.schema import (
    AuditRuleTemplateCreate,
    AuditRuleTemplateUpdate,
    AuditRuleTemplateQueryParam,
    AuditRuleTemplateBatchDelete
)

RuleTemplateRouter = APIRouter(
    route_class=OperationLogRoute,
    prefix="/audit/rule-template",
    tags=["审计规则模板管理"]
)


@router.get('/list', summary='获取规则模板列表')
async def get_template_list(
    query_params: AuditRuleTemplateQueryParam = Depends(),
    page: int = Query(1, ge=1, description='页码'),
    limit: int = Query(10, ge=1, le=100, description='每页数量'),
    db: AsyncSession = Depends(db_getter)
):
    """获取规则模板列表（分页）"""
    data = await service.list_service(db, query_params, page, limit)
    return StandardListResponse(data=data)


@router.get('/all', summary='获取所有启用的模板')
async def get_all_active_templates(
    db: AsyncSession = Depends(db_getter)
):
    """获取所有启用的规则模板"""
    data = await service.all_active_service(db)
    return StandardResponse(data=data)


@router.get('/options', summary='获取模板选项')
async def get_template_options(
    db: AsyncSession = Depends(db_getter)
):
    """获取规则模板下拉框选项"""
    data = await service.options_service(db)
    return StandardResponse(data=data)


@router.get('/detail/{template_id}', summary='获取模板详情')
async def get_template_detail(
    template_id: int = Path(..., description='模板ID'),
    db: AsyncSession = Depends(db_getter)
):
    """获取规则模板详情"""
    data = await service.detail_service(db, template_id)
    if not data:
        return StandardResponse(code=404, message='模板不存在')
    return StandardResponse(data=data)


@router.post('/create', summary='创建规则模板')
async def create_template(
    create_data: AuditRuleTemplateCreate,
    db: AsyncSession = Depends(db_getter)
):
    """创建规则模板"""
    try:
        data = await service.create_service(db, create_data)
        return StandardResponse(data=data, message='创建成功')
    except ValueError as e:
        return StandardResponse(code=400, message=str(e))


@router.put('/update', summary='更新规则模板')
async def update_template(
    template_id: int = Query(..., description='模板ID'),
    update_data: AuditRuleTemplateUpdate = None,
    db: AsyncSession = Depends(db_getter)
):
    """更新规则模板"""
    try:
        data = await service.update_service(db, template_id, update_data)
        return StandardResponse(data=data, message='更新成功')
    except ValueError as e:
        return StandardResponse(code=400, message=str(e))


@router.delete('/delete/{template_id}', summary='删除单个模板')
async def delete_single_template(
    template_id: int = Path(..., description='模板ID'),
    db: AsyncSession = Depends(db_getter)
):
    """删除单个规则模板"""
    count = await service.delete_service(db, [template_id])
    if count == 0:
        return StandardResponse(code=404, message='模板不存在')
    return StandardResponse(message='删除成功')


@router.delete('/delete', summary='批量删除模板')
async def delete_batch_templates(
    delete_data: AuditRuleTemplateBatchDelete,
    db: AsyncSession = Depends(db_getter)
):
    """批量删除规则模板"""
    count = await service.delete_service(db, delete_data.ids)
    return StandardResponse(message=f'成功删除 {count} 个模板')
